{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "altgrid-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY",
      "PRIVATE_LICENSE_KEY",
      "MERCADOPAGO_ACCESS_TOKEN",
      "MERCADOPAGO_WEBHOOK_SECRET",
      "MERCADOPAGO_WEBHOOK_URL"
    ]
  },
  "vars": {
    "ALLOWED_ORIGINS": "altgrid://app,https://localhost,http://localhost,capacitor://localhost,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:4173,https://acvisualdigital.github.io,https://altgrid.com.br,https://www.altgrid.com.br",
    "FIREBASE_PROJECT_ID": "altgrid-d0504",
    "LICENSE_KEY_ID": "altgrid-license-v1",
    "WHATSAPP_GRAPH_API_VERSION": "v23.0",
    "WHATSAPP_TEMPLATE_NAME": "altgrid_admin_alert",
    "WHATSAPP_TEMPLATE_LANGUAGE": "pt_BR"
  },
  "ratelimits": [
    {
      "name": "EDGE_RATE_LIMITER",
      "namespace_id": "375911",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "USER_RATE_LIMITER",
      "namespace_id": "375912",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "DEVICE_RATE_LIMITER",
      "namespace_id": "375913",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "375914",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "PAYMENT_RATE_LIMITER",
      "namespace_id": "375915",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
