{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "altgrid-site-secure",
  "main": "site-security/worker.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "routes": [
    { "pattern": "altgrid.com.br/*", "zone_name": "altgrid.com.br" },
    { "pattern": "www.altgrid.com.br/*", "zone_name": "altgrid.com.br" }
  ],
  "assets": {
    "directory": "./build/site",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "build": { "command": "node scripts/build-secure-site.mjs" }
}
