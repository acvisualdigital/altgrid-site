# Worker-only secrets. Copy to .dev.vars for local development.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional in staging. Pix endpoints stay unavailable until all three are set.
MERCADOPAGO_ACCESS_TOKEN=your-mercado-pago-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-mercado-pago-webhook-secret
MERCADOPAGO_WEBHOOK_URL=https://api.example.com/v1/webhooks/mercadopago
# PKCS#8 Ed25519 private key, base64 or PEM. Keep this server-side only.
PRIVATE_LICENSE_KEY=your-pkcs8-ed25519-private-key
